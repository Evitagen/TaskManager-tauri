{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Manager",
  "version": "2.0.0",
  "identifier": "com.taskmanager.tauri",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Task Manager",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"]
  }
}
